{
  "expo": {
    "name": "VAZORA",
    "slug": "vazora",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "vazora",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vazora.app"
    },
    "android": {
      "package": "com.vazora.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-system-ui"
    ]
  }
}
